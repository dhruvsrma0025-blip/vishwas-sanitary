# Server
PORT=5000
NODE_ENV=development

# Comma-separate multiple origins if needed. Leave blank to allow the current origin.
CLIENT_ORIGIN=http://localhost:5173

# ── Email notifications via Brevo (recommended) ──────────────────────────────
# Messages are always saved to server/messages.json. Fill these in to also
# receive an email copy of every contact form submission.
# BREVO_SENDER_EMAIL must be a verified sender in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=shop-owner@example.com
BREVO_SENDER_NAME=Vishwas Sanitary and Fancy Items
MAIL_TO=shop-owner@example.com

# ── Optional SMTP fallback (used only when Brevo is not configured) ──────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Groq chat assistant ──────────────────────────────────────────────────────
# Create a key at https://console.groq.com/keys. Keep it server-side only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
